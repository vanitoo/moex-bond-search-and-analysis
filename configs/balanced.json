{
  "strategy": "balanced",
  "modules": {
    "market_search": {
      "enabled": true,
      "mode": "hard_filter",
      "version": "v1",
      "yield_more": 15,
      "yield_less": 40,
      "price_more": 70,
      "price_less": 120,
      "duration_more": 3,
      "duration_less": 18,
      "volume_more": 2000,
      "bond_volume_more": 60000,
      "require_known_coupons": true,
      "workers": 5,
      "cache_hours": 12
    },
    "cashflow": {"enabled": true, "mode": "hard_filter", "require_complete": true},
    "news_search": {"enabled": true, "mode": "information"},
    "news": {"enabled": true, "mode": "hard_stop"},
    "liquidity": {"enabled": true, "mode": "score", "impact_share": 0.10},
    "ofz_spread": {"enabled": true, "mode": "score", "warning_bp": 600, "critical_bp": 1000},
    "analysis": {"enabled": true, "mode": "score"},
    "deep_analysis": {"enabled": true, "mode": "score"},
    "credit": {"enabled": true, "mode": "hard_filter", "minimum_rating": "BBB-"},
    "decision": {"enabled": true, "mode": "hard_filter"}
  }
}
