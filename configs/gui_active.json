{
  "strategy": "balanced",
  "http": {
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36",
    "accept_language": "ru-RU,ru;q=0.9,en;q=0.8"
  },
  "modules": {
    "market_search": {
      "enabled": true,
      "mode": "hard_filter",
      "yield_more": 15.0,
      "price_more": 70.0,
      "duration_more": 3.0,
      "volume_more": 2000.0,
      "yield_less": 40.0,
      "price_less": 120.0,
      "duration_less": 18.0,
      "bond_volume_more": 60000.0,
      "require_known_coupons": true,
      "version": "v1"
    },
    "cashflow": {
      "enabled": true,
      "mode": "hard_filter",
      "require_complete": true
    },
    "news_search": {
      "enabled": true,
      "mode": "information",
      "providers": ["google", "moex", "acra", "expert_ra"],
      "proxy_enabled": false,
      "proxy_env": "NEWS_PROXY",
      "minimum_successful_providers": 1
    },
    "news": {
      "enabled": true,
      "mode": "hard_stop"
    },
    "liquidity": {
      "enabled": true,
      "mode": "score",
      "impact_share": 0.1
    },
    "ofz_spread": {
      "enabled": true,
      "mode": "score",
      "warning_bp": 600,
      "critical_bp": 1000
    },
    "analysis": {
      "enabled": true,
      "mode": "score"
    },
    "deep_analysis": {
      "enabled": true,
      "mode": "score"
    },
    "credit": {
      "enabled": true,
      "mode": "hard_filter",
      "minimum_rating": "BBB-"
    },
    "decision": {
      "enabled": true,
      "mode": "hard_filter"
    }
  }
}